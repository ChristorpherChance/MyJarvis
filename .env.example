# Model secrets are stored by Pi in the private .jarvis folder through the console.
# Reference only: the server reads system environment variables, not this file.
# Study-room validation stays on loopback; LAN requires the explicit settings below.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3140
# Optional absolute directory; do not use a synced/public directory.
# JARVIS_DATA_DIR=D:/AI/jarvis-private
# Optional model selection (use Pi provider / model IDs).
# JARVIS_PI_PROVIDER=provider-id-from-settings
# JARVIS_PI_MODEL=model-id-from-settings
# JARVIS_PI_API_KEY=your-api-key
# Optional fixed local Python and pre-downloaded ASR model.
# JARVIS_PYTHON=D:/JarvisPlatform/.runtime-venv/Scripts/python.exe
# JARVIS_WHISPER_MODEL=D:/JarvisData/runtime/models/whisper-tiny
# OCR permits one or two CPU threads (default two).
# JARVIS_KNOWLEDGE_CPU_THREADS=2
# For the 48GB central server, use an exact Host allowlist and trusted HTTPS.
# JARVIS_HOST=0.0.0.0
# JARVIS_ALLOW_LAN=1
# JARVIS_ALLOWED_HOSTS=127.0.0.1,192.168.1.48,jarvis.home
# JARVIS_TLS_KEY=D:/JarvisTLS/server-key.pem
# JARVIS_TLS_CERT=D:/JarvisTLS/server-cert.pem

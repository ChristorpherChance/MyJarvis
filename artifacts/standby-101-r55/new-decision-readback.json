      "runId": null,
      "taskId": null,
      "machineId": null,
      "objectives": [],
      "constraints": [
        "112是正式主平台；101保持冷备，独立软件工厂不受影响。",
        "费用只记账、未知分列，不设金额上限；十分钟自动监督仍暂停。",
        "不覆盖满额项目notes，不改工厂目标、计划、监督项或原决策。"
      ],
      "situation": "已完成101隔离载荷安装、临时运行检查、129件兼容资产与现存语音材料核验。program-v2实际切换R55且仅observer重启，三冷业务单元仍disabled/inactive。112已完成64文件、59目录、4633958902字节与10个SQLite一致快照并恢复R55健康；私有传输、101全树恢复及接管不由本条推定。 后继实际已完成私有包校核、101隔离恢复与全树换入，10库通过，原101数据保留。112正式健康、101R55冷停与跨节点TLS观察已读回；快照仅为原时点，900秒阈值和非持续同步保持。"
    },
    "options": [
      {
        "id": "cold-code-and-private-recovery-separate",
        "title": "更新冷备程序并核验私有恢复副本，保留原数据和接管隔离门",
        "advantages": [
          "保留旧资产与历史恢复路径。",
          "不启101冷业务，不影响独立软件工厂。"
        ],
        "disadvantages": [
          "程序对齐不能替代私有数据恢复和接管验证。"
        ],
        "impact": "101程序与冷备数据已更新；112仍唯一正式主，三冷服务disabled/inactive；不启动或操作独立软件工厂。",

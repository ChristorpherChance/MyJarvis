+import test from 'node:test';import assert from 'node:assert/strict';import {build} from 'esbuild';import {mkdtemp,writeFile,rm} from 'node:fs/promises';import {resolve,join} from 'node:path';import {pathToFileURL} from 'node:url';import React from 'react';import {renderToStaticMarkup} from 'react-dom/server';
+test('real workbench long goal stays folded; current goal/run decision and project next action stay distinct',async()=>{const dir=await mkdtemp(resolve('.r43-tools/r49r1-'));try{const shim=join(dir,'hooks.mjs'),react=resolve('node_modules/react/index.js');await writeFile(shim,`export * from ${JSON.stringify(react)};import R from ${JSON.stringify(react)};export default R;export const useState=v=>[globalThis.__states.length?globalThis.__states.shift():typeof v==='function'?v():v,()=>{}];export const useRef=v=>({current:v});export const useEffect=()=>{};`);const out=join(dir,'ui.mjs');await build({entryPoints:['apps/web/src/features/operations/ProjectWorkbenchPage.tsx'],outfile:out,bundle:true,platform:'node',format:'esm',packages:'external',jsx:'automatic',loader:{'.css':'empty'},plugins:[{name:'hooks',setup(b){b.onResolve({filter:/^react$/},()=>({path:shim}));}}],logLevel:'silent'});const Page=(await import(pathToFileURL(out).href)).EntityWorkbench;
+// Synthetic equal-length representative; actual private planB6 bytes unavailable here.
+let goal=[...Array.from({length:12},(_,i)=>`F${String(i+1).padStart(2,'0')} 软件能力原文${i}`),...Array.from({length:5},(_,i)=>`S${String(i+1).padStart(2,'0')} 监管要求原文${i}`),'未知格式保持原文'].join('\n');goal+='补充原文'.repeat(400);goal=goal.slice(0,1691);assert.equal(goal.length,1691);const plan={projectId:'p',goal,title:'项目计划',currentStepId:'C1',nextAction:'项目后续行动',steps:['C','N'].flatMap(prefix=>Array.from({length:6},(_,i)=>({id:prefix+(i+1),title:'原阶段'+prefix+(i+1),criteria:['原验收条款'+prefix+(i+1)],state:'planned'})))};
+const context={project:{id:'p',goal},supervisor:{session:{goalRevision:3,runId:'new',status:'waiting_user',blocker:'当前新阻塞',nextAction:'本轮很长安排'.repeat(80),criteria:[]},events:[{goalRevision:2,runId:'old',sequence:8,kind:'review',decision:{reason:'旧成功不可当前'}},{goalRevision:3,runId:'wrong',sequence:9,kind:'decision',decision:{reason:'错run不可当前'}},{goalRevision:3,runId:'new',sequence:7,kind:'feedback',feedback:{summary:'当前CC回应'}},{goalRevision:3,runId:'new',sequence:6,kind:'instruction',directive:'当前指令'}]},execution:{state:'succeeded'},choices:[],pending:[]};
+const render=c=>{globalThis.__states=[c,plan,'2026-10-18T00:00:00Z','live'];return Page({projectId:'p',projectName:'项目短标题',params:new URLSearchParams(),data:{projects:[{id:'p',name:'项目短标题'}],machines:[]},navigate:()=>{}});};const tree=render(context);delete globalThis.__states;
+function visible(n){if(Array.isArray(n))return n.flatMap(visible);if(!React.isValidElement(n))return [n];if(n.type==='details'&&!n.props.open)return [React.cloneElement(n,{},React.Children.toArray(n.props.children).filter(c=>React.isValidElement(c)&&c.type==='summary'))];return [React.cloneElement(n,{},...visible(n.props.children))];}const compact=renderToStaticMarkup(React.createElement(React.Fragment,null,...visible(tree))),full=renderToStaticMarkup(tree);for(const value of ['项目短标题','C1','当前指令','当前CC回应','当前新阻塞','项目后续行动'])assert.ok(compact.includes(value),value);for(const value of [goal,'原验收条款C6','旧成功不可当前','错run不可当前','本轮很长安排'])assert.ok(!compact.includes(value),value);for(const value of ['F01','F12','S01','S05','当前阶段','后续阶段','原验收条款N6','未知格式保持原文','上次判断（历史，非当前）'])assert.ok(full.includes(value),value);assert.match(full,/<button type="submit"/);
+const current=structuredClone(context);current.supervisor.session.blocker='';current.supervisor.events.push({goalRevision:3,runId:'new',sequence:10,kind:'decision',summary:'当前摘要',decision:{reason:'当前理由'}});const currentHtml=renderToStaticMarkup(render(current));assert.ok(currentHtml.includes('当前理由'));assert.ok(currentHtml.includes('上次判断（历史，非当前）'));console.log(JSON.stringify({scope:'production component SSR tree; synthetic1691 chars/C1-C6/N1-N6, not actual planB6 bytes/DOM/viewport acceptance',foldedDefault:true,currentGoalRun:true,originalsRetained:true}));}finally{delete globalThis.__states;await rm(dir,{recursive:true,force:true});}});

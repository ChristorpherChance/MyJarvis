+test('real PiService.run supervisor byte gate reaches offline native driver; other purpose/partial gates remain',async()=>{const dir=await mkdtemp(join(tmpdir(),'r51r1-entry-'));const oldFetch=globalThis.fetch;let requests=0,drivers=0,partial=false;globalThis.fetch=async()=>{requests++;throw Error('fixture network forbidden');};const runtime=await ModelRuntime.create({authPath:join(dir,'fixture-auth.json'),modelsPath:null,refreshOnCreate:false});const decision={action:'stop',directive:'',reason:'fixture',selectedOption:null,criteria:[],experienceReferences:[]};runtime.registerProvider('offline-entry',{baseUrl:'http://127.0.0.1:1',apiKey:'fixture-only',api:'offline-entry',models:[{id:'fixture',name:'offline',reasoning:false,input:['text'],cost:{input:0,output:0,cacheRead:0,cacheWrite:0},contextWindow:32768,maxTokens:4096}],streamSimple:()=>{drivers++;const stream=createAssistantMessageEventStream();const message:any={role:'assistant',api:'offline-entry',provider:'offline-entry',model:'fixture',content:[{type:'text',text:JSON.stringify(decision)}],stopReason:partial?'length':'stop',timestamp:Date.now(),usage:{input:0,output:0,cacheRead:0,cacheWrite:0,totalTokens:0,cost:{input:0,output:0,cacheRead:0,cacheWrite:0,total:0}}};queueMicrotask(()=>{stream.push({type:'start',partial:message});stream.push({type:'done',reason:partial?'length':'stop',message} as any);stream.end();});return stream;}});const pi:any=new PiService(dir,{} as any);pi.runtime=runtime;pi.provider='offline-entry';pi.model='fixture';pi.authenticatedProviders=new Set(['offline-entry']);pi.configured=true;pi.initialize=async()=>{};pi.refreshConfigured=async()=>{};await mkdir(pi.cwd,{recursive:true});await mkdir(pi.agentDir,{recursive:true});
+let sequence=0;const input=(text:string,supervisor=true)=>({text,actorId:'server-admin',conversationId:'entry-'+(++sequence),member:{name:'fixture',preferences:''},sessionPath:null,boundedJob:true,ephemeral:true,...(supervisor?{purpose:'project-supervisor',scenario:'project-supervisor'}:{}),onEvent:()=>{},onSessionPath:()=>{}});
+try{for(const text of ['a'.repeat(31000),'a'.repeat(44830),'中'.repeat(21845)+'a']){const before=drivers;const result=await pi.run(input(text));assert.equal(result.status,'complete');assert.equal(drivers,before+1);}const before=drivers;await assert.rejects(pi.run(input('中'.repeat(21845)+'ab')),/PI_INPUT_INVALID/);await assert.rejects(pi.run(input('a'.repeat(32001),false)),/PI_INPUT_INVALID/);await assert.rejects(pi.run(input('   ')),/PI_INPUT_INVALID/);assert.equal(drivers,before);assert.equal((await pi.run(input('a'.repeat(32000),false))).status,'complete');partial=true;assert.notEqual((await pi.run(input('partial fixture'))).status,'complete');await assert.rejects(createProjectSupervisorModel(pi)({goal:'fixture',criteria:[],experienceReferences:[]}),/MODEL_RUN_FAILED/);assert.equal(requests,0);console.log(JSON.stringify({scope:'real PiService.run + actual SDK offline driver; no provider/network',asciiAccepted:[31000,44830],multibyteBoundaryUTF8:65536,overLimitZeroDriver:true,otherPurpose32000Preserved:true,partialRejected:true,providerTotalTokens:null,driverCalls:drivers,networkRequests:requests}));}finally{await pi.dispose();globalThis.fetch=oldFetch;await rm(dir,{recursive:true,force:true});}});
